# Model used by Evolyn through LiteLLM
OPENAI_API_KEY=
MODEL=openai/gpt-5-mini
TEMPERATURE=0.2

# Cognee's own LLM/embedding configuration
# For OpenAI, these can use the same key as above.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
LLM_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# Optional Langfuse observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_OTEL_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Evolyn runtime
MEMORY_DATASET=evolyn_experiences
MEMORY_TOP_K=8
