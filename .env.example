# Primary LLM. Change only this line to switch models/providers.
# LiteLLM format: openrouter/<OpenRouter model ID>.
MODEL=openrouter/stealth/ox-alpha
TEMPERATURE=0.2

# Optional comma-separated fallback chain.
# Examples:
# FALLBACK_MODELS=gemini/<model>,groq/<model>,nvidia_nim/<model>,ollama/<local-model>
FALLBACK_MODELS=

# Provider credentials. Keep real secrets only in .env.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# Local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# Cognee's own LLM configuration. Cognee uses LiteLLM internally.
# OpenRouter is an OpenAI-compatible custom provider.
LLM_PROVIDER=custom
LLM_MODEL=openrouter/stealth/ox-alpha
LLM_ENDPOINT=https://openrouter.ai/api/v1
LLM_API_KEY=

# Cognee embeddings are configured independently from Evolyn's reasoning model.
# The default below keeps embeddings local; change this later if desired.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Keep Cognee storage inside the Evolyn project, not inside .venv/site-packages.
# Forward slashes are recommended on Windows.
SYSTEM_ROOT_DIRECTORY=./data/cognee/system
DATA_ROOT_DIRECTORY=./data/cognee/data

# Optional Langfuse observability. Keep disabled until credentials are valid.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_OTEL_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Evolyn runtime.
MEMORY_DATASET=evolyn_experiences
MEMORY_TOP_K=8
