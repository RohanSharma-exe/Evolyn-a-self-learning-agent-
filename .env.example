# Primary LLM. Change only this line to switch models/providers.
# LiteLLM format: openrouter/<OpenRouter model ID>.
MODEL=openrouter/stealth/ox-alpha
TEMPERATURE=0.2

# Optional comma-separated fallback chain.
# Examples:
# FALLBACK_MODELS=gemini/gemini-3.6-flash,groq/<model>,nvidia_nim/<model>,ollama/<local-model>
FALLBACK_MODELS=

# Provider credentials. Keep real secrets only in .env.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# Local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# Cognee's own LLM/embedding configuration.
# These can be configured independently from Evolyn's reasoning model.
LLM_PROVIDER=openrouter
LLM_MODEL=stealth/ox-alpha
LLM_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# Keep Cognee storage inside the Evolyn project, not inside .venv/site-packages.
# Forward slashes are recommended on Windows.
SYSTEM_ROOT_DIRECTORY=./data/cognee/system
DATA_ROOT_DIRECTORY=./data/cognee/data

# Optional Langfuse observability.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_OTEL_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Evolyn runtime.
MEMORY_DATASET=evolyn_experiences
MEMORY_TOP_K=8
